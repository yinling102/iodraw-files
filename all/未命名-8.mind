{"root":{"data":{"id":"dn5piedz1000","created":1795753563476,"text":"聚类","font-weight":"bold"},"children":[{"data":{"id":"dn5pk7mexsw0","created":1795753705478,"text":"聚类任务"},"children":[{"data":{"id":"dn5pkerv8qo0","created":1795753721045,"text":"任务"},"children":[{"data":{"id":"dn5pklfgze80","created":1795753735533,"text":"将训练集划分为若干簇，簇的对应概念事先未知"},"children":[]}]},{"data":{"id":"dn5pki9rcqo0","created":1795753728657,"text":"区分"},"children":[{"data":{"id":"dn5pkokd2740","created":1795753742359,"text":"分类是有监督，已知类别；聚类是无监督，没有标签，挖掘数据内在分组结构。"},"children":[]}]}]},{"data":{"id":"dn5pkao6py80","created":1795753712115,"text":"性能度量"},"children":[{"data":{"id":"dn5pkto92s00","created":1795753753478,"text":"外部指标"},"children":[{"data":{"id":"dn5pl0ulj540","created":1795753769099,"text":"有参考标准答案，和真实簇划分对比"},"children":[]}]},{"data":{"id":"dn5pkxr60r40","created":1795753762361,"text":"内部指标"},"children":[]}]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}