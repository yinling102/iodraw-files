{"root":{"data":{"id":"dn5piedz1000","created":1795753563476,"text":"聚类","font-weight":"bold"},"children":[{"data":{"id":"dn5pk7mexsw0","created":1795753705478,"text":"聚类任务"},"children":[{"data":{"id":"dn5pkerv8qo0","created":1795753721045,"text":"任务"},"children":[{"data":{"id":"dn5pklfgze80","created":1795753735533,"text":"将训练集划分为若干簇，簇的对应概念事先未知"},"children":[]}]},{"data":{"id":"dn5pki9rcqo0","created":1795753728657,"text":"区分"},"children":[{"data":{"id":"dn5pkokd2740","created":1795753742359,"text":"分类是有监督，已知类别；聚类是无监督，没有标签，挖掘数据内在分组结构。"},"children":[]}]}]},{"data":{"id":"dn5pkao6py80","created":1795753712115,"text":"性能度量"},"children":[{"data":{"id":"dn5pkto92s00","created":1795753753478,"text":"外部指标"},"children":[{"data":{"id":"dn5pl0ulj540","created":1795753769099,"text":"有参考标准答案，和真实簇划分对比"},"children":[]},{"data":{"id":"dn5pl8826cg0","created":1795753785151,"text":"Jaccard系数"},"children":[{"data":{"id":"dn5plvaj1hs0","created":1795753835366,"text":"衡量两个集合相似度，越大越好"},"children":[]}]},{"data":{"id":"dn5plb4lafs0","created":1795753791471,"text":"FM指数"},"children":[{"data":{"id":"dn5plye33w80","created":1795753842111,"text":"匹配度，取值[0,1]，越大聚类效果越好"},"children":[]}]},{"data":{"id":"dn5plf5pc6o0","created":1795753800246,"text":"Rand指数"},"children":[{"data":{"id":"dn5pm1hhso00","created":1795753848848,"text":"样本对划分一致性，取值[0,1]，越大越好"},"children":[]}]}]},{"data":{"id":"dn5pkxr60r40","created":1795753762361,"text":"内部指标"},"children":[{"data":{"id":"dn5pl46uxdk0","created":1795753776371,"text":"没有参考，仅基于样本簇内/簇间距离评估"},"children":[]},{"data":{"id":"dn5plijybqo0","created":1795753807637,"text":"DB指数"},"children":[{"data":{"id":"dn5pm6j3iw00","created":1795753859829,"text":"计算每个簇内平均距离、簇中心之间距离，值越小越好"},"children":[]}]},{"data":{"id":"dn5plnsgc680","created":1795753819035,"text":"Dunn指数"},"children":[{"data":{"id":"dn5pm9n0m000","created":1795753866596,"text":"最小簇间距离/最大簇内距离，值越大越好"},"children":[]}]}]}]},{"data":{"id":"dn5pmfogos00","created":1795753879744,"text":"距离计算"},"children":[{"data":{"id":"dn5pmjcgofk0","created":1795753887726,"text":"距离用来衡量样本相似度"},"children":[]},{"data":{"id":"dn5pmn1km000","created":1795753895774,"text":"闵可夫斯基距离"},"children":[{"data":{"id":"dn5pmvz4dls0","created":1795753915217,"text":"p=1：曼哈顿距离"},"children":[]},{"data":{"id":"dn5pn6dd4s00","created":1795753937846,"text":"p=2：欧氏距离"},"children":[]},{"data":{"id":"dn5pnbcc6140","created":1795753948668,"text":"p→∞：切比雪夫距离"},"children":[]}]},{"data":{"id":"dn5pnj8dvpc0","created":1795753965843,"text":"有序属性（连续数值）使用闵可夫斯基距离"},"children":[]},{"data":{"id":"dn5pnmivpy00","created":1795753973008,"text":"无序属性（离散类别）使用VDM距离。"},"children":[]},{"data":{"id":"dn5pnqhdwtc0","created":1795753981625,"text":"混合属性"},"children":[{"data":{"id":"dn5pnuc1l1s0","created":1795753990009,"text":"既有有序又有无序，将闵可夫斯基和VDM结合"},"children":[]}]},{"data":{"id":"dn5pnza7u7c0","created":1795754000782,"text":"特性"},"children":[]}]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}